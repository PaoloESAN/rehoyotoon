---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import HeaderBar from '../components/HeaderBar.astro';
import AssetGrid from '../components/AssetGrid.astro';
import DetailModal from '../components/DetailModal.astro';
import FileBrowserModal from '../components/FileBrowserModal.astro';
---

<Layout title="HoyoToon Assets">
  <div class="app-shell">
    <Sidebar />
    <main class="main-content">
      <HeaderBar />
      <AssetGrid />
    </main>
  </div>

  <DetailModal />
  <FileBrowserModal />

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</Layout>

<script>
  import { ASSETS, GAMES, type AssetItem, type GameId } from '../data/assets';
  import {
    generatePortraitSvg,
    getElementIconSvg,
    getWeaponOrPathIconSvg,
  } from '../utils/icons';

  const CATEGORY_ICONS: Record<string, string> = {
    characters: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="14" height="16" rx="2"/><path d="M17 8h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9"/><circle cx="10" cy="10" r="2.2"/><path d="M6.5 16c.8-1.6 2.1-2.4 3.5-2.4s2.7.8 3.5 2.4"/></svg>`,
    weapons: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 17.5L3 6V3h3l11.5 11.5"/><path d="M13 19l6-6M16 16l4 4M19 21l2-2"/></svg>`,
    lightcones: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l7 4v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-4z"/></svg>`,
    wengines: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>`,
    monsters: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a7 7 0 0 0-7 7v4a5 5 0 0 0 10 0v0"/><path d="M5 14v2a7 7 0 0 0 14 0v-2a7 7 0 0 0-7-7"/><circle cx="9.5" cy="11.5" r="1" fill="currentColor"/><circle cx="14.5" cy="11.5" r="1" fill="currentColor"/></svg>`,
    npcs: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    gadgets: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M5 10h14a2 2 0 0 1 2 2v3a6 6 0 0 1-6 6H9a6 6 0 0 1-6-6v-3a2 2 0 0 1 2-2z"/></svg>`,
    objects: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
  };

  interface AppState {
    game: GameId;
    category: string;
    search: string;
    sort: string;
    rarity: 'all' | '4' | '5';
    element: string;
    wp: string;
    activeItem: AssetItem | null;
    activeVariantIndex: number;
    currentFolder: string | null;
  }

  const state: AppState = {
    game: 'gi',
    category: 'characters',
    search: '',
    sort: 'id-desc',
    rarity: 'all',
    element: 'all',
    wp: 'all',
    activeItem: null,
    activeVariantIndex: 0,
    currentFolder: null,
  };

  // DOM References
  const categoryRail = document.getElementById('category-rail')!;
  const headerEyebrow = document.getElementById('header-eyebrow')!;
  const headerTitle = document.getElementById('header-title')!;
  const pillAvailable = document.getElementById('pill-available')!;
  const pillTotal = document.getElementById('pill-total')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const assetGrid = document.getElementById('asset-grid')!;

  const filterToggleBtn = document.getElementById('filter-toggle-btn')!;
  const filterPopover = document.getElementById('filter-popover')!;
  const activeFilterCount = document.getElementById('active-filter-count')!;
  const filterRarityChips = document.getElementById('filter-rarity-chips')!;
  const filterElementChips = document.getElementById('filter-element-chips')!;
  const filterWpChips = document.getElementById('filter-wp-chips')!;
  const clearFiltersBtn = document.getElementById('clear-filters-btn')!;

  const detailBackdrop = document.getElementById('detail-backdrop')!;
  const detailEyebrow = document.getElementById('detail-eyebrow')!;
  const detailTitle = document.getElementById('detail-title')!;
  const detailMetaPills = document.getElementById('detail-meta-pills')!;
  const variantsSelectedTitle = document.getElementById('variants-selected-title')!;
  const variantsSubtitle = document.getElementById('variants-subtitle')!;
  const variantsGrid = document.getElementById('variants-grid')!;
  const detailCloseBtn = document.getElementById('detail-close-btn')!;
  const detailDownloadBtn = document.getElementById('detail-download-btn')!;
  const detailFilesBtn = document.getElementById('detail-files-btn')!;

  const filesBackdrop = document.getElementById('files-backdrop')!;
  const filesEyebrow = document.getElementById('files-eyebrow')!;
  const filesTitle = document.getElementById('files-title')!;
  const fileScopeCount = document.getElementById('file-scope-count')!;
  const scopePillsRow = document.getElementById('scope-pills-row')!;
  const filesBreadcrumb = document.getElementById('files-breadcrumb')!;
  const filesList = document.getElementById('files-list')!;
  const filesCloseBtn = document.getElementById('files-close-btn')!;

  const toastEl = document.getElementById('toast')!;
  let toastTimer: number | undefined;

  function showToast(message: string) {
    toastEl.innerHTML = `
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e5b84b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12" />
      </svg>
      <span>${message}</span>
    `;
    toastEl.classList.add('show');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2600);
  }

  function triggerDownload(filename: string, content: string) {
    const blob = new Blob([content], { type: 'application/octet-stream' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    showToast(`Downloading ${filename}`);
  }

  function syncUrl() {
    const params = new URLSearchParams();
    params.set('game', state.game);
    params.set('type', state.category);
    if (state.activeItem) {
      params.set('entity', String(state.activeItem.id));
      const v = state.activeItem.variants[state.activeVariantIndex];
      if (v) params.set('variant', v.id);
    }
    const nextUrl = `${window.location.pathname}?${params.toString()}`;
    window.history.replaceState(null, '', nextUrl);
  }

  function getActiveGame() {
    return GAMES.find((g) => g.id === state.game) ?? GAMES[0];
  }

  function getCategoryItems() {
    return ASSETS.filter((a) => a.game === state.game && a.category === state.category);
  }

  function renderSidebar() {
    document.querySelectorAll<HTMLButtonElement>('#game-rail .game-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.gameId === state.game);
    });

    const game = getActiveGame();
    categoryRail.innerHTML = game.categories
      .map(
        (cat) => `
        <button
          type="button"
          class="rail-btn cat-btn ${cat.id === state.category ? 'active' : ''}"
          data-cat-id="${cat.id}"
          aria-label="${cat.label}"
        >
          ${CATEGORY_ICONS[cat.id] ?? CATEGORY_ICONS.characters}
          <span class="rail-tooltip">${cat.label.toUpperCase()}</span>
        </button>
      `
      )
      .join('');

    categoryRail.querySelectorAll<HTMLButtonElement>('.cat-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextCat = btn.dataset.catId!;
        if (nextCat !== state.category) {
          state.category = nextCat;
          resetFilters();
          renderAll();
        }
      });
    });
  }

  function resetFilters() {
    state.search = '';
    state.rarity = 'all';
    state.element = 'all';
    state.wp = 'all';
    searchInput.value = '';
  }

  function renderFilterOptions() {
    const items = getCategoryItems();
    const elements = Array.from(new Set(items.map((i) => i.element)));
    const wps = Array.from(new Set(items.map((i) => i.weaponOrPath)));

    filterRarityChips.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((chip) => {
      chip.classList.toggle('selected', chip.dataset.rarity === state.rarity);
    });

    filterElementChips.innerHTML = ['all', ...elements]
      .map(
        (el) => `
        <button type="button" class="filter-chip ${state.element === el ? 'selected' : ''}" data-element="${el}">
          ${el === 'all' ? 'All' : el}
        </button>
      `
      )
      .join('');

    filterWpChips.innerHTML = ['all', ...wps]
      .map(
        (wp) => `
        <button type="button" class="filter-chip ${state.wp === wp ? 'selected' : ''}" data-wp="${wp}">
          ${wp === 'all' ? 'All' : wp}
        </button>
      `
      )
      .join('');

    filterElementChips.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.element = btn.dataset.element!;
        renderFilterOptions();
        renderGrid();
      });
    });

    filterWpChips.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.wp = btn.dataset.wp!;
        renderFilterOptions();
        renderGrid();
      });
    });

    const activeCount =
      (state.rarity !== 'all' ? 1 : 0) +
      (state.element !== 'all' ? 1 : 0) +
      (state.wp !== 'all' ? 1 : 0);

    activeFilterCount.textContent = String(activeCount);
    activeFilterCount.style.display = activeCount > 0 ? 'inline-block' : 'none';
  }

  function renderHeader() {
    const game = getActiveGame();
    const cat = game.categories.find((c) => c.id === state.category) ?? game.categories[0];
    headerEyebrow.textContent = game.name;
    headerTitle.textContent = cat.label;
    searchInput.placeholder = cat.searchPlaceholder;
  }

  function getFilteredAndSortedItems(): AssetItem[] {
    const q = state.search.trim().toLowerCase();
    const filtered = getCategoryItems().filter((item) => {
      if (q && !item.name.toLowerCase().includes(q)) return false;
      if (state.rarity !== 'all' && String(item.rarity) !== state.rarity) return false;
      if (state.element !== 'all' && item.element !== state.element) return false;
      if (state.wp !== 'all' && item.weaponOrPath !== state.wp) return false;
      return true;
    });

    return filtered.sort((a, b) => {
      switch (state.sort) {
        case 'id-asc':
          return a.id - b.id;
        case 'name-asc':
          return a.name.localeCompare(b.name);
        case 'name-desc':
          return b.name.localeCompare(a.name);
        case 'id-desc':
        default:
          return b.id - a.id;
      }
    });
  }

  function renderGrid() {
    const totalItems = getCategoryItems().length;
    const items = getFilteredAndSortedItems();

    pillAvailable.textContent = `${items.length} available`;
    pillTotal.textContent = `${totalItems} total`;

    if (items.length === 0) {
      assetGrid.innerHTML = `
        <div class="empty-state">
          <p style="margin:0 0 6px;font-weight:700;color:#fff;">No assets match your filters</p>
          <p style="margin:0;font-size:13px;">Try clearing your search or filter selections.</p>
        </div>
      `;
      return;
    }

    const showCardBadges = state.game === 'gi' || state.game === 'hsr';

    assetGrid.innerHTML = items
      .map((item) => {
        const portrait = generatePortraitSvg(
          item.name,
          item.palette,
          item.element,
          item.category,
          item.hairStyle
        );

        const badgesHtml = showCardBadges
          ? `
            <div class="card-badges">
              <span class="card-badge-circle" title="${item.element}">
                ${getElementIconSvg(item.element, 14)}
              </span>
              <span class="card-badge-circle" title="${item.weaponOrPath}">
                ${getWeaponOrPathIconSvg(item.weaponOrPath, 13)}
              </span>
            </div>
          `
          : '';

        return `
          <button
            type="button"
            class="asset-card rarity-${item.rarity}"
            data-entity-id="${item.id}"
            aria-label="${item.name}"
          >
            ${portrait}
            ${badgesHtml}
            <div class="card-overlay">
              <p class="card-name">${item.name}</p>
            </div>
          </button>
        `;
      })
      .join('');

    assetGrid.querySelectorAll<HTMLButtonElement>('.asset-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = Number(card.dataset.entityId);
        const found = ASSETS.find((a) => a.id === id);
        if (found) openDetailModal(found);
      });
    });
  }

  function openDetailModal(item: AssetItem, variantIndex = 0) {
    state.activeItem = item;
    state.activeVariantIndex = Math.min(variantIndex, item.variants.length - 1);
    renderDetailModal();
    detailBackdrop.classList.add('open');
    detailBackdrop.setAttribute('aria-hidden', 'false');
    syncUrl();
  }

  function closeDetailModal() {
    detailBackdrop.classList.remove('open');
    detailBackdrop.setAttribute('aria-hidden', 'true');
    if (!filesBackdrop.classList.contains('open')) {
      state.activeItem = null;
      syncUrl();
    }
  }

  function renderDetailModal() {
    const item = state.activeItem;
    if (!item) return;

    const game = GAMES.find((g) => g.id === item.game) ?? GAMES[0];
    const activeVariant = item.variants[state.activeVariantIndex] ?? item.variants[0];

    detailEyebrow.textContent = game.name;
    detailTitle.textContent = item.name;

    detailMetaPills.innerHTML = `
      <span class="meta-pill">
        ${getElementIconSvg(item.element, 13)}
        <span>${item.element.toUpperCase()}</span>
      </span>
      <span class="meta-pill">
        ${getWeaponOrPathIconSvg(item.weaponOrPath, 13)}
        <span>${item.weaponOrPath.toUpperCase()}</span>
      </span>
      <span class="meta-pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="#e5b84b" stroke="#e5b84b" stroke-width="1.5">
          <polygon points="12 2 15 9 22 9 16.5 14 18.5 21 12 17 5.5 21 7.5 14 2 9 9 9 12 2"/>
        </svg>
        <span>${item.rarity} STAR</span>
      </span>
    `;

    variantsSelectedTitle.textContent = activeVariant.name;
    variantsSubtitle.textContent =
      item.variants.length === 1 ? '1 variant' : `${item.variants.length} variants`;

    variantsGrid.innerHTML = item.variants
      .map((variant, idx) => {
        const portrait = generatePortraitSvg(
          `${item.name}_${variant.name}`,
          variant.palette,
          item.element,
          item.category,
          item.hairStyle
        );
        return `
          <button
            type="button"
            class="variant-card ${idx === state.activeVariantIndex ? 'active' : ''}"
            data-variant-idx="${idx}"
          >
            ${portrait}
            <div class="variant-card-overlay">
              <span class="variant-card-tag">${variant.label ?? 'VARIANT'}</span>
              <span class="variant-card-name">${variant.name}</span>
            </div>
          </button>
        `;
      })
      .join('');

    variantsGrid.querySelectorAll<HTMLButtonElement>('.variant-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.activeVariantIndex = Number(btn.dataset.variantIdx);
        renderDetailModal();
        syncUrl();
      });
    });
  }

  function countVariantFiles(item: AssetItem, variantIdx: number) {
    const v = item.variants[variantIdx] ?? item.variants[0];
    const folderCount = v.folders.reduce((sum, f) => sum + f.items.length, 0);
    return folderCount + v.rootFiles.length;
  }

  function openFileBrowser() {
    if (!state.activeItem) return;
    state.currentFolder = null;
    renderFileBrowser();
    filesBackdrop.classList.add('open');
    filesBackdrop.setAttribute('aria-hidden', 'false');
  }

  function closeFileBrowser() {
    filesBackdrop.classList.remove('open');
    filesBackdrop.setAttribute('aria-hidden', 'true');
  }

  function renderFileBrowser() {
    const item = state.activeItem;
    if (!item) return;

    const game = GAMES.find((g) => g.id === item.game) ?? GAMES[0];
    const variant = item.variants[state.activeVariantIndex] ?? item.variants[0];

    filesEyebrow.textContent = `${game.shortName} / ${item.name.toUpperCase()}`;
    filesTitle.textContent = variant.name;
    fileScopeCount.textContent = `${state.activeVariantIndex + 1}/${item.variants.length} available`;

    scopePillsRow.innerHTML = item.variants
      .map((v, idx) => {
        const total = countVariantFiles(item, idx);
        return `
          <button
            type="button"
            class="scope-card ${idx === state.activeVariantIndex ? 'active' : ''}"
            data-scope-idx="${idx}"
          >
            <span class="scope-card-tag">${v.label ?? 'VARIANT'}</span>
            <span class="scope-card-name">${v.name}</span>
            <span class="scope-card-files">${total} files</span>
          </button>
        `;
      })
      .join('');

    scopePillsRow.querySelectorAll<HTMLButtonElement>('.scope-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.activeVariantIndex = Number(btn.dataset.scopeIdx);
        state.currentFolder = null;
        renderDetailModal();
        renderFileBrowser();
      });
    });

    // Breadcrumb
    filesBreadcrumb.innerHTML = `
      <button type="button" class="crumb-btn ${state.currentFolder === null ? 'active' : ''}" id="crumb-root-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Root</span>
      </button>
      ${
        state.currentFolder
          ? `<span style="color:var(--text-muted);">&gt;</span><span class="crumb-btn active">${state.currentFolder}</span>`
          : ''
      }
    `;

    document.getElementById('crumb-root-btn')?.addEventListener('click', () => {
      state.currentFolder = null;
      renderFileBrowser();
    });

    const folderIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`;
    const chevronRight = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>`;
    const dlIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;
    const cubeIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`;
    const docIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>`;
    const imgIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;

    const renderFileRow = (file: { name: string; type: string; subtitle: string; size: string }) => {
      const icon = file.type === 'model' ? cubeIcon : file.type === 'texture' ? imgIcon : docIcon;
      return `
        <div class="file-row">
          <div class="file-row-left">
            <div class="file-icon-box">${icon}</div>
            <div style="min-width:0;">
              <div class="file-row-title">${file.name}</div>
              <div class="file-row-sub">${file.subtitle}</div>
            </div>
          </div>
          <div class="file-row-right">
            <span class="file-size">${file.size}</span>
            <button type="button" class="file-dl-btn" data-dl-file="${file.name}" title="Download ${file.name}" aria-label="Download ${file.name}">
              ${dlIcon}
            </button>
          </div>
        </div>
      `;
    };

    if (state.currentFolder === null) {
      const foldersHtml = variant.folders
        .map(
          (folder) => `
          <button type="button" class="file-row folder-row" data-folder-name="${folder.name}">
            <div class="file-row-left">
              <div class="file-icon-box">${folderIcon}</div>
              <div>
                <div class="file-row-title">${folder.name}</div>
                <div class="file-row-sub">${folder.items.length} items</div>
              </div>
            </div>
            <div class="file-row-right" style="color:var(--text-muted);">
              ${chevronRight}
            </div>
          </button>
        `
        )
        .join('');

      const rootFilesHtml = variant.rootFiles.map(renderFileRow).join('');
      filesList.innerHTML = foldersHtml + rootFilesHtml;

      filesList.querySelectorAll<HTMLButtonElement>('.folder-row').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.currentFolder = btn.dataset.folderName!;
          renderFileBrowser();
        });
      });
    } else {
      const folder = variant.folders.find((f) => f.name === state.currentFolder);
      const backBtnHtml = `
        <button type="button" class="back-root-row" id="back-to-root-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          <span>Back to Root</span>
        </button>
      `;
      const itemsHtml = (folder?.items ?? []).map(renderFileRow).join('');
      filesList.innerHTML = backBtnHtml + itemsHtml;

      document.getElementById('back-to-root-btn')?.addEventListener('click', () => {
        state.currentFolder = null;
        renderFileBrowser();
      });
    }

    filesList.querySelectorAll<HTMLButtonElement>('.file-dl-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const fname = btn.dataset.dlFile!;
        const manifest = JSON.stringify(
          {
            source: 'HoyoToon Assets Replica',
            game: game.name,
            entity: item.name,
            variant: variant.name,
            file: fname,
            exportedAt: new Date().toISOString(),
          },
          null,
          2
        );
        triggerDownload(fname, manifest);
      });
    });
  }

  function renderAll() {
    renderSidebar();
    renderHeader();
    renderFilterOptions();
    renderGrid();
    syncUrl();
  }

  // Event Listeners
  document.querySelectorAll<HTMLButtonElement>('#game-rail .game-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const nextGame = btn.dataset.gameId as GameId;
      if (nextGame !== state.game) {
        state.game = nextGame;
        const gameDef = getActiveGame();
        state.category = gameDef.categories[0].id;
        resetFilters();
        renderAll();
      }
    });
  });

  document.getElementById('brand-home-btn')?.addEventListener('click', () => {
    state.game = 'gi';
    state.category = 'characters';
    resetFilters();
    closeFileBrowser();
    closeDetailModal();
    renderAll();
  });

  searchInput.addEventListener('input', () => {
    state.search = searchInput.value;
    renderGrid();
  });

  sortSelect.addEventListener('change', () => {
    state.sort = sortSelect.value;
    renderGrid();
  });

  filterToggleBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = filterPopover.classList.toggle('open');
    filterToggleBtn.classList.toggle('active', isOpen);
    filterToggleBtn.setAttribute('aria-expanded', String(isOpen));
  });

  filterRarityChips.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.rarity = btn.dataset.rarity as 'all' | '4' | '5';
      renderFilterOptions();
      renderGrid();
    });
  });

  clearFiltersBtn.addEventListener('click', () => {
    state.rarity = 'all';
    state.element = 'all';
    state.wp = 'all';
    renderFilterOptions();
    renderGrid();
  });

  document.addEventListener('click', (e) => {
    if (!filterPopover.contains(e.target as Node) && !filterToggleBtn.contains(e.target as Node)) {
      filterPopover.classList.remove('open');
      filterToggleBtn.classList.remove('active');
      filterToggleBtn.setAttribute('aria-expanded', 'false');
    }
  });

  detailCloseBtn.addEventListener('click', closeDetailModal);
  detailBackdrop.addEventListener('click', (e) => {
    if (e.target === detailBackdrop) closeDetailModal();
  });

  detailDownloadBtn.addEventListener('click', () => {
    if (!state.activeItem) return;
    const variant = state.activeItem.variants[state.activeVariantIndex] ?? state.activeItem.variants[0];
    const bundleManifest = JSON.stringify(
      {
        entity: state.activeItem.name,
        game: state.activeItem.game,
        variant: variant.name,
        files: [
          ...variant.rootFiles.map((f) => f.name),
          ...variant.folders.flatMap((fl) => fl.items.map((i) => `${fl.name}/${i.name}`)),
        ],
      },
      null,
      2
    );
    triggerDownload(`${state.activeItem.name.replace(/\s+/g, '_')}_${variant.id}_bundle.json`, bundleManifest);
  });

  detailFilesBtn.addEventListener('click', openFileBrowser);
  filesCloseBtn.addEventListener('click', closeFileBrowser);
  filesBackdrop.addEventListener('click', (e) => {
    if (e.target === filesBackdrop) closeFileBrowser();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (filesBackdrop.classList.contains('open')) {
        closeFileBrowser();
      } else if (detailBackdrop.classList.contains('open')) {
        closeDetailModal();
      } else if (filterPopover.classList.contains('open')) {
        filterPopover.classList.remove('open');
        filterToggleBtn.classList.remove('active');
      }
    }
  });

  // Initialize from URL query parameters (?game=gi&type=characters&entity=10000150)
  function initFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const g = params.get('game') as GameId | null;
    if (g && GAMES.some((gm) => gm.id === g)) {
      state.game = g;
    }
    const gameDef = getActiveGame();
    const t = params.get('type');
    if (t && gameDef.categories.some((c) => c.id === t)) {
      state.category = t;
    } else {
      state.category = gameDef.categories[0].id;
    }

    renderAll();

    const entityId = params.get('entity');
    if (entityId) {
      const found = ASSETS.find((a) => a.id === Number(entityId));
      if (found) {
        const variantParam = params.get('variant');
        const vIdx = variantParam
          ? Math.max(0, found.variants.findIndex((v) => v.id === variantParam))
          : 0;
        openDetailModal(found, vIdx);
      }
    }
  }

  initFromUrl();
</script>
