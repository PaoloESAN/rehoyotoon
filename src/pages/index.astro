---
import CatalogPage from '../components/CatalogPage.astro';
import { GAMES } from '../data/assets';

const gameMap = Object.fromEntries(
  GAMES.map((g) => [g.id, g.categories.map((c) => c.id)])
);
---

<CatalogPage activeGame="gi" activeCategory="characters" isHome>
  <script slot="head-script" is:inline define:vars={{ gameMap }}>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const g = params.get('game');
      const t = params.get('type');
      if (!g && !t) return;

      const targetGame = g && gameMap[g] ? g : 'gi';
      const cats = gameMap[targetGame] || ['characters'];
      const targetType = t && cats.includes(t) ? t : cats[0];

      const nextParams = new URLSearchParams();
      const entity = params.get('entity');
      const variant = params.get('variant');
      if (entity) nextParams.set('entity', entity);
      if (variant) nextParams.set('variant', variant);

      const qs = nextParams.toString();
      window.location.replace(`/${targetGame}/${targetType}${qs ? `?${qs}` : ''}`);
    })();
  </script>
</CatalogPage>
