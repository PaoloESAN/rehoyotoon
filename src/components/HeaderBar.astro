---
import { GAMES, type GameId } from '../data/assets';

interface Props {
  activeGame: GameId;
  activeCategory: string;
  totalCount: number;
}

const { activeGame, activeCategory, totalCount } = Astro.props;
const game = GAMES.find((g) => g.id === activeGame) ?? GAMES[0];
const cat = game.categories.find((c) => c.id === activeCategory) ?? game.categories[0];
---

<section class="header-card" aria-label="Asset Catalog Header">
  <p class="header-eyebrow" id="header-eyebrow">{game.name}</p>
  <h1 class="header-title" id="header-title">{cat.label}</h1>

  <div class="header-pills">
    <span class="count-pill available" id="pill-available">{totalCount} available</span>
    <span class="count-pill total" id="pill-total">{totalCount} total</span>
  </div>

  <div class="controls-bar">
    <button type="button" class="filter-trigger" id="filter-toggle-btn" aria-expanded="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
      </svg>
      <span>Filter</span>
      <span class="filter-badge" id="active-filter-count" style="display:none;">0</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </button>

    <div class="search-wrap">
      <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        type="search"
        class="search-input"
        id="search-input"
        placeholder={cat.searchPlaceholder}
        autocomplete="off"
      />
    </div>

    <div class="sort-select-wrap">
      <select class="sort-select" id="sort-select" aria-label="Sort assets">
        <option value="id-desc">ID descending</option>
        <option value="id-asc">ID ascending</option>
        <option value="name-asc">Name A-Z</option>
        <option value="name-desc">Name Z-A</option>
      </select>
      <svg class="sort-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </div>

    <!-- Filter Popover -->
    <div class="filter-popover" id="filter-popover" role="dialog" aria-label="Filter Options">
      <div class="filter-section">
        <span class="filter-label">Rarity</span>
        <div class="filter-chips" id="filter-rarity-chips">
          <button type="button" class="filter-chip selected" data-rarity="all">All</button>
          <button type="button" class="filter-chip" data-rarity="5">5 Star</button>
          <button type="button" class="filter-chip" data-rarity="4">4 Star</button>
        </div>
      </div>

      <div class="filter-section">
        <span class="filter-label">Element</span>
        <div class="filter-chips" id="filter-element-chips"></div>
      </div>

      <div class="filter-section">
        <span class="filter-label" id="filter-wp-label">Weapon / Path</span>
        <div class="filter-chips" id="filter-wp-chips"></div>
      </div>

      <div class="filter-footer">
        <button type="button" class="clear-filters-btn" id="clear-filters-btn">Clear filters</button>
      </div>
    </div>
  </div>
</section>
