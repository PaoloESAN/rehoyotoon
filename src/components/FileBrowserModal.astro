---
---

<div class="modal-backdrop files-backdrop" id="files-backdrop" aria-hidden="true">
  <div class="files-modal" role="dialog" aria-modal="true" aria-labelledby="files-title">
    <div class="files-modal-header">
      <div>
        <p class="drawer-eyebrow" id="files-eyebrow">HSR / MYDEI</p>
        <h2 class="drawer-title" id="files-title">Destruction</h2>
      </div>
      <button type="button" class="icon-close-btn" id="files-close-btn" aria-label="Close file browser">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <div class="files-modal-body">
      <div class="file-scope-box">
        <div class="file-scope-top">
          <div>
            <p class="file-scope-label">FILE SCOPE</p>
            <p class="file-scope-desc">Choose the outfit, model, or asset whose files you want to browse.</p>
          </div>
          <span class="file-scope-count" id="file-scope-count">1/1 available</span>
        </div>
        <div class="scope-pills-row" id="scope-pills-row">
          <!-- Populated dynamically -->
        </div>
      </div>

      <div class="breadcrumb-bar" id="files-breadcrumb">
        <!-- Populated dynamically -->
      </div>

      <div class="file-list" id="files-list">
        <!-- Populated dynamically -->
      </div>
    </div>
  </div>
</div>
