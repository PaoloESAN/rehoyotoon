---
---

<dialog class="credits-dialog" id="credits-dialog" closedby="any" aria-labelledby="credits-title">
  <div class="drawer-top-row">
    <div>
      <p class="drawer-eyebrow">ARCHIVE CONTRIBUTORS</p>
      <h2 class="drawer-title" id="credits-title">Credits</h2>
    </div>
    <button type="button" class="icon-close-btn" id="credits-close-btn" aria-label="Close credits">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <div class="credits-list">
    <div class="credit-card">
      <span class="credit-handle">Original creators of HoyoToon</span>
      <p class="credit-desc">
        For creating the original HoyoToon website, shaders, and community tools.
      </p>
    </div>

    <div class="credit-card">
      <span class="credit-handle">@hywe3d</span>
      <p class="credit-desc">
        For compiling and organizing the asset archive.
      </p>
    </div>

    <div class="credit-card">
      <span class="credit-handle">@failsafe65</span>
      <p class="credit-desc">
        Made a parallel archive, shared/gathered a ton of assets, and helped a ton with double-checking the supply.
      </p>
    </div>

    <div class="credit-card">
      <span class="credit-handle">@katherine. · @destinyklein · @tinala · @risingenergy</span>
      <p class="credit-desc">
        Helped with gathering different assets and cataloging for the archive.
      </p>
    </div>
  </div>
</dialog>
