---
---

<dialog class="detail-drawer" id="detail-dialog" closedby="any" aria-labelledby="detail-title">
  <div class="drawer-top-row">
    <div>
      <p class="drawer-eyebrow" id="detail-eyebrow">GENSHIN IMPACT</p>
      <h2 class="drawer-title" id="detail-title">Odette</h2>
    </div>
    <button type="button" class="icon-close-btn" id="detail-close-btn" aria-label="Close detail panel">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <div class="drawer-action-bar">
    <button type="button" class="btn-gold" id="detail-download-btn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      <span>Download</span>
    </button>
  </div>

  <div class="drawer-meta-pills" id="detail-meta-pills">
    <!-- Populated dynamically -->
  </div>

  <div class="variants-section">
    <div class="variants-header">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 2 7 12 12 22 7 12 2" />
        <polyline points="2 17 12 22 22 17" />
        <polyline points="2 12 12 17 22 12" />
      </svg>
      <span>VARIANTS</span>
    </div>
    <h3 class="variants-selected-title" id="variants-selected-title">Snow Swan's Dance</h3>
    <p class="variants-subtitle" id="variants-subtitle">1 variant</p>

    <div class="variants-grid" id="variants-grid">
      <!-- Populated dynamically -->
    </div>
  </div>
</dialog>
