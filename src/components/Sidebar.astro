---
import { GAMES } from '../data/assets';
---

<aside class="sidebar-rail" aria-label="Primary Navigation">
  <button
    type="button"
    class="brand-badge"
    id="brand-home-btn"
    title="HoyoToon Assets"
    aria-label="HoyoToon Assets Home"
  >
    HT
  </button>

  <div class="rail-group" id="game-rail">
    {
      GAMES.map((game) => (
        <button
          type="button"
          class="rail-btn game-btn"
          data-game-id={game.id}
          aria-label={game.name}
        >
          <span class="game-emblem" data-emblem={game.id}>
            {game.id === 'gi' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" fill="#1e293b" stroke="#7dd3fc" stroke-width="1.5" />
                <path d="M12 5L14.2 10L19 12L14.2 14L12 19L9.8 14L5 12L9.8 10L12 5Z" fill="#e0f2fe" />
              </svg>
            )}
            {game.id === 'hsr' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" fill="#2e1a2b" stroke="#f472b6" stroke-width="1.5" />
                <path d="M7 15C9 9 14 7 18 8C15 11 13 15 9 17L7 15Z" fill="#fde047" />
                <circle cx="15" cy="9" r="2" fill="#f9a8d4" />
              </svg>
            )}
            {game.id === 'zzz' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="5" fill="#18181b" stroke="#facc15" stroke-width="1.5" />
                <path d="M7 8H11L8 12H11M13 12H17L14 16H17" stroke="#facc15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {game.id === 'hi3' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" fill="#1e1b4b" stroke="#c084fc" stroke-width="1.5" />
                <path d="M8 16L12 6L16 16M9.5 13H14.5" stroke="#f5d0fe" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </span>
          <span class="rail-tooltip">{game.name}</span>
        </button>
      ))
    }
  </div>

  <div class="rail-divider" role="separator"></div>

  <div class="rail-group" id="category-rail">
    <!-- Populated dynamically per active game -->
  </div>
</aside>
