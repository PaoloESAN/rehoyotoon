---
import { Image } from 'astro:assets';
import { GAMES } from '../data/assets';
import hoyotoonLogo from '../assets/logos/hoyotoon-logo.png';
import genshinIcon from '../assets/logos/genshin-icon.webp';
import hsrIcon from '../assets/logos/hsr-icon.webp';
import zzzIcon from '../assets/logos/zzz-icon.jpg';
import hi3Icon from '../assets/logos/hi3-icon.png';

const GAME_LOGOS: Record<string, ImageMetadata> = {
  gi: genshinIcon,
  hsr: hsrIcon,
  zzz: zzzIcon,
  hi3: hi3Icon,
};
---

<aside class="sidebar-rail" aria-label="Primary Navigation">
  <button
    type="button"
    class="brand-badge"
    id="brand-home-btn"
    title="HoyoToon Assets"
    aria-label="HoyoToon Assets Home"
  >
    <Image src={hoyotoonLogo} alt="HoyoToon" width={48} height={48} loading="eager" />
  </button>

  <div class="rail-group" id="game-rail">
    {
      GAMES.map((game) => (
        <button
          type="button"
          class="rail-btn game-btn"
          data-game-id={game.id}
          aria-label={game.name}
        >
          <span class="game-emblem" data-emblem={game.id}>
            <Image src={GAME_LOGOS[game.id]} alt={game.name} width={48} height={48} loading="eager" />
          </span>
          <span class="rail-tooltip">{game.name}</span>
        </button>
      ))
    }
  </div>

  <div class="rail-divider" role="separator"></div>

  <div class="rail-group" id="category-rail">
    <!-- Populated dynamically per active game -->
  </div>
</aside>
